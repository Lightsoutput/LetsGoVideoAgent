# -------------------- Application --------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OUTBOUND_HTTP_PROXY=
LOG_LEVEL=INFO

# P0 默认使用内存仓库，便于第一次启动；Docker Compose 会覆盖为 mysql。
REPOSITORY_BACKEND=memory
SEED_DEMO_DATA=false
LOCAL_DATA_DIR=./data
VIDEO_LIBRARY_DIR=./videos
SKILL_ARTIFACT_DIR=./skills/generated
ENABLE_REMOTE_DOWNLOADS=false
# 可选：需要登录态的 B 站视频可填写 edge、chrome 或 firefox。
YTDLP_COOKIES_FROM_BROWSER=

# -------------------- MySQL --------------------
MYSQL_DATABASE=lets_go_video_agent
MYSQL_USER=video_agent
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_me
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=3306
DATABASE_URL=mysql+aiomysql://video_agent:change_me@mysql:3306/lets_go_video_agent

# -------------------- Redis / Qdrant / MinIO --------------------
REDIS_PASSWORD=change_redis_me
REDIS_URL=redis://:change_redis_me@redis:6379/0
REDIS_HOST_PORT=6379
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=video_artifacts
QDRANT_HTTP_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_minio_me
MINIO_BUCKET=video-agent
MINIO_SECURE=false
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# -------------------- Temporal --------------------
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=video-processing
WORKFLOW_BACKEND=inline
TEMPORAL_HOST_PORT=7233
TEMPORAL_UI_HOST_PORT=8233

# -------------------- Host ports / image tag --------------------
API_HOST_PORT=8000
WEB_HOST_PORT=3000
APP_IMAGE_TAG=local

# -------------------- Model routing --------------------
# economy / balanced / high_accuracy
MODEL_PROFILE=economy
LLM_PROVIDER=mock
LLM_MODEL=mock-evidence-model
LLM_API_KEY=
LLM_API_BASE=
LOCAL_ASR_MODEL=small
DEEPSEEK_CACHE_HIT_PRICE_CNY_PER_MILLION=0.02
DEEPSEEK_CACHE_MISS_PRICE_CNY_PER_MILLION=1.0
DEEPSEEK_OUTPUT_PRICE_CNY_PER_MILLION=2.0
VLM_PROVIDER=siliconflow
VLM_MODEL=Qwen/Qwen3-VL-32B-Instruct
VLM_API_KEY=
VLM_API_BASE=https://api.siliconflow.cn/v1
FRAME_VLM_TIMEOUT_SECONDS=45
FRAME_TOOL_TIMEOUT_SECONDS=65
SEARCH_PROVIDER=mcp
SEARCH_API_BASE=http://127.0.0.1:8888
SEARCH_MCP_URL=http://127.0.0.1:8090/mcp
SEARXNG_HOST_PORT=8888
SEARCH_MCP_HOST=127.0.0.1
SEARCH_MCP_PORT=8090
SEARCH_MCP_HOST_PORT=8090
DOCKER_VLM_API_BASE=http://host.docker.internal:11434
DOCKER_SEARCH_API_BASE=http://searxng:8080
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding-model

# 单次问答的默认硬预算。Harness 会在任何昂贵调用前进行检查。
AGENT_MAX_MODEL_CALLS=6
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_TOKENS=12000
AGENT_MAX_COST_USD=0.10
AGENT_DEADLINE_SECONDS=60

# -------------------- Observability --------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
