            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/videos/imports": {
      "post": {
        "tags": [
          "videos"
        ],
        "summary": "Import Video",
        "operationId": "import_video_api_v1_videos_imports_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebImportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Video"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/videos/uploads": {
      "post": {
        "tags": [
          "videos"
        ],
        "summary": "Upload Video",
        "operationId": "upload_video_api_v1_videos_uploads_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_video_api_v1_videos_uploads_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Video"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/videos/{video_id}/timeline": {
      "get": {
        "tags": [
          "timeline"
        ],
        "summary": "Get Timeline",
        "operationId": "get_timeline_api_v1_videos__video_id__timeline_get",
        "parameters": [
          {
            "name": "video_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Video Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimelineResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/videos/{video_id}/questions": {
      "post": {
        "tags": [
          "agent"
        ],
        "summary": "Ask Video",
        "operationId": "ask_video_api_v1_videos__video_id__questions_post",
        "parameters": [
          {
            "name": "video_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Video Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskQuestionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Answer"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agent-runs/{run_id}": {
      "get": {
        "tags": [
          "agent"
        ],
        "summary": "Get Agent Run",
        "operationId": "get_agent_run_api_v1_agent_runs__run_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRun"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentRun": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "agent_name": {
            "type": "string",
            "title": "Agent Name"
          },
          "agent_version": {
            "type": "string",
            "title": "Agent Version"
          },
          "video_id": {
            "type": "string",
            "format": "uuid",
            "title": "Video Id"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "title": "Conversation Id"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus",
            "default": "running"
          },
          "budget": {
            "$ref": "#/components/schemas/RunBudget"
          },
          "usage": {
            "$ref": "#/components/schemas/ModelUsage"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/AgentStep"
            },
            "type": "array",
            "title": "Steps"
          },
          "stop_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stop Reason"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "agent_name",
          "agent_version",
          "video_id",
          "conversation_id",
          "budget"
        ],
        "title": "AgentRun",
        "description": "可展示的运行记录，不保存模型隐藏思维链。\n\nTrace 只记录节点、公开工具、输入摘要、结果摘要、用量和错误。这样既可排障，\n也不会把内部推理当作产品功能暴露给前端。"
      },
      "AgentStep": {
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Index"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Elapsed Ms",
            "default": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "index",
          "kind",
          "name",
          "status",
          "summary"
        ],
        "title": "AgentStep"
      },
      "Answer": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "question_id": {
            "type": "string",
            "format": "uuid",
            "title": "Question Id"
          },
          "status": {
            "$ref": "#/components/schemas/AnswerStatus"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/EvidenceCitation"
            },
            "type": "array",
            "title": "Citations"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "default": 0
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          },
          "trace_id": {
            "type": "string",
            "format": "uuid",
            "title": "Trace Id"
          },
          "usage": {
            "$ref": "#/components/schemas/ModelUsage"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question_id",
          "status",
          "text",
          "trace_id"
        ],
        "title": "Answer"
      },
      "AnswerStatus": {
        "type": "string",
        "enum": [
          "answered",
          "partial",
          "abstained"
        ],
        "title": "AnswerStatus"
      },
      "AskQuestionRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query"
          },
          "target": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/GlobalTarget"
              },
              {
                "$ref": "#/components/schemas/RangeTarget"
              },
              {
                "$ref": "#/components/schemas/MomentTarget"
              },
              {
                "$ref": "#/components/schemas/FrameTarget"
              }
            ],
            "title": "Target",
            "discriminator": {
              "propertyName": "kind",
              "mapping": {
                "frame": "#/components/schemas/FrameTarget",
                "global": "#/components/schemas/GlobalTarget",
                "moment": "#/components/schemas/MomentTarget",
                "range": "#/components/schemas/RangeTarget"
              }
            }
          },
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query"
        ],
        "title": "AskQuestionRequest"
      },
      "Body_upload_video_api_v1_videos_uploads_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "MP4/MOV/MKV/WebM 视频文件"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_video_api_v1_videos_uploads_post"
      },
      "Evidence": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "video_id": {
            "type": "string",
            "format": "uuid",
            "title": "Video Id"
          },
          "kind": {
            "$ref": "#/components/schemas/EvidenceKind"
          },
          "artifact_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Artifact Ids"
          },
          "time_range": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TimeRange"
              },
              {
                "type": "null"
              }
            ]
          },
          "timestamp_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp Ms"
          },
          "frame_index": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Frame Index"
          },
          "spatial_region": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SpatialRegion"
              },
              {
                "type": "null"
              }
            ]
          },
          "quote": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quote"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "default": 1
          },
          "snapshot_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Url"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "video_id",
          "kind",
          "description",
          "provenance"
        ],
        "title": "Evidence",
        "description": "支持回答结论的证据。\n\n`quote` 只保存字幕/OCR 原文，`description` 保存系统解释。二者分开后，验证器\n才能判断“视频直接说了什么”和“模型推断了什么”。"
      },
      "EvidenceCitation": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "format": "uuid",
            "title": "Evidence Id"
          },
          "timestamp_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Timestamp Ms"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "snapshot_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "evidence_id",
          "timestamp_ms",
          "label"
        ],
        "title": "EvidenceCitation"
      },
      "EvidenceKind": {
        "type": "string",
        "enum": [
          "transcript",
          "visual",
          "ocr",
          "audio",
          "timeline",
          "frame"
        ],
        "title": "EvidenceKind"
      },
      "FrameTarget": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "frame",
            "title": "Kind",
            "default": "frame"
          },
          "timestamp_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Timestamp Ms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "timestamp_ms"
        ],
        "title": "FrameTarget"
      },
      "GlobalTarget": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "global",
            "title": "Kind",
            "default": "global"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "GlobalTarget"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "repository": {
            "type": "string",
            "title": "Repository"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "version",
          "repository"
        ],
        "title": "HealthResponse"
      },
      "ModelUsage": {
        "properties": {
          "model_calls": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Model Calls",
            "default": 0
          },
          "tool_calls": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Tool Calls",
            "default": 0
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Input Tokens",
            "default": 0
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Output Tokens",
            "default": 0
          },
          "estimated_cost_usd": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Estimated Cost Usd",
            "default": "0"
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Elapsed Ms",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ModelUsage",
        "description": "模型与 Agent 调用用量；金额用 Decimal，避免费用统计出现浮点累积误差。"
      },
      "MomentTarget": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "moment",
            "title": "Kind",
            "default": "moment"
          },
          "timestamp_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Timestamp Ms"
          },
          "context_window_ms": {
            "type": "integer",
            "maximum": 60000.0,
            "minimum": 1000.0,
            "title": "Context Window Ms",
            "default": 8000
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "timestamp_ms"
        ],
        "title": "MomentTarget"
      },
      "ObservationType": {
        "type": "string",
        "enum": [
          "direct",
          "inference",
          "user_annotation"
        ],
        "title": "ObservationType"
      },
      "Provenance": {
        "properties": {
          "producer": {
            "type": "string",
            "title": "Producer"
          },
          "producer_version": {
            "type": "string",
            "title": "Producer Version",
            "default": "0.1.0"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "prompt_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Version"
          },
          "tool_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Version"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "producer"
        ],
        "title": "Provenance",
        "description": "记录某条信息从哪里来，支持回答后的证据审计。"
      },
      "RangeTarget": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "range",
            "title": "Kind",
            "default": "range"
          },
          "time_range": {
            "$ref": "#/components/schemas/TimeRange"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "time_range"
        ],
        "title": "RangeTarget"
      },
      "RunBudget": {
        "properties": {
          "max_steps": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Max Steps",
            "default": 12
          },
          "max_tool_calls": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Max Tool Calls",
            "default": 10
          },
          "max_model_calls": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Max Model Calls",
            "default": 6
          },
          "max_tokens": {
            "type": "integer",
